/* Paleta AURABYTE Security Terminal */
$ast-fondo: #0a111e;
$ast-superficie: #0e1828;
$ast-panel: #142136;
$ast-linea: #2c405c;
$ast-seleccion: #18394a;
$ast-borde: #66e3cd;
$ast-acento: #aebdff;
$ast-exito: #66e3cd;
$ast-error: #ff8d9a;
$ast-aviso: #ffd680;
$ast-texto: #e6edf6;
$ast-texto-tenue: #a2b1c8;

Screen {
    background: $ast-fondo;
    color: $ast-texto;
}

VerticalScroll, DataTable, OptionList, RichLog {
    scrollbar-color: $ast-linea;
    scrollbar-color-hover: $ast-borde;
    scrollbar-background: $ast-fondo;
}

#encabezado {
    height: 3;
    background: $ast-superficie;
    border-bottom: solid $ast-linea;
    color: $ast-texto;
    padding: 1 1 0 1;
}

#encabezado > * {
    width: auto;
}

.logo {
    color: $ast-borde;
    text-style: bold;
}

#encabezado .nombre {
    color: $ast-texto;
    text-style: bold;
}

#encabezado .dato {
    color: $ast-texto-tenue;
    height: 1;
}

#encabezado-proyecto {
    max-width: 28;
}

#encabezado.compacto #encabezado-version,
#encabezado.compacto #encabezado-so {
    display: none;
}

#encabezado.compacto #encabezado-proyecto {
    width: 1fr;
}

#encabezado .boton-info {
    height: 1;
    min-width: 0;
    border: none;
    background: $ast-panel;
    color: $ast-texto-tenue;
    padding: 0 1;
    margin-left: 1;
}

#encabezado-acciones {
    dock: right;
    width: auto;
    height: 1;
}

#encabezado-acciones > Button {
    width: auto;
}

#encabezado.minimo #encabezado-menu,
#encabezado.minimo #encabezado-proyecto {
    display: none;
}

#encabezado .boton-info:hover,
#encabezado .boton-info:focus,
#encabezado .boton-info.visible {
    color: $ast-borde;
    background: $ast-seleccion;
}

#cuerpo {
    height: 1fr;
}

#barra-lateral {
    width: 23;
    height: 1fr;
    padding: 1 1;
    background: $ast-superficie;
    color: $ast-texto;
    border: none;
    border-right: solid $ast-linea;
    scrollbar-size-vertical: 1;
}

#barra-lateral.compacta {
    width: 21;
    padding: 1 0;
}

#barra-lateral > .option-list--option {
    padding: 0;
}

#barra-lateral > .option-list--option-highlighted {
    background: $ast-seleccion;
    color: $ast-borde;
}

#switcher-central {
    width: 1fr;
    height: 1fr;
    background: $ast-fondo;
    padding: 1 2;
}

#panel-info {
    width: 32;
    height: 1fr;
    background: $ast-superficie;
    border-left: solid $ast-linea;
    padding: 1 1;
    scrollbar-size-vertical: 1;
}

#info-seccion,
.info-comando {
    margin-bottom: 1;
}

#panel-info.ampliado {
    width: 1fr;
}

#switcher-central.info-en-primer-plano,
#panel-info.oculto,
.info-comando.oculto {
    display: none;
}

.titulo-panel {
    text-style: bold;
    color: $ast-borde;
    margin-bottom: 1;
}

.ast-subtitulo {
    text-style: bold;
    color: $ast-acento;
    margin-top: 1;
}

#inicio-marca {
    height: auto;
    align-vertical: middle;
    border-left: thick $ast-borde;
    padding: 1 2;
    margin-bottom: 1;
    background: $ast-panel;
}

#inicio-marca > Vertical {
    width: 1fr;
    height: auto;
}

#inicio-escudo {
    width: auto;
    margin-right: 2;
}

#inicio-nombre {
    text-style: bold;
    color: $ast-texto;
}

PanelInicio.compacto #inicio-marca {
    padding: 1 1 0 1;
}

PanelInicio.compacto #inicio-escudo {
    display: none;
}

#inicio-metricas,
#inicio-accesos {
    height: auto;
    grid-size: 3;
    grid-rows: auto;
    grid-gutter: 0 1;
}

#inicio-metricas {
    margin-bottom: 1;
}

.inicio-metrica {
    height: auto;
    min-height: 4;
    padding: 0 1;
    background: $ast-superficie;
    border-top: solid $ast-linea;
    color: $ast-texto;
}

PanelInicio.estrecho #inicio-accesos {
    grid-size: 2;
}

#inicio-accesos Button,
.modulo-ficha Button {
    width: 1fr;
    min-width: 0;
    padding: 0;
}

.modulos-grupo {
    height: auto;
    grid-size: 2;
    grid-rows: auto;
    grid-gutter: 1 1;
    margin: 1 0;
}

PanelModulos.compacto .modulos-grupo {
    grid-size: 1;
}

.modulo-ficha {
    height: auto;
    padding: 0 1 1 1;
    background: $ast-superficie;
    border-top: solid $ast-linea;
}

.modulo-ficha > Static {
    margin-top: 1;
}

.ast-caja {
    background: $ast-panel;
    border: round $ast-linea;
    padding: 0 1;
    margin-bottom: 1;
}

.ast-exito {
    color: $ast-exito;
    text-style: bold;
}

.ast-error {
    color: $ast-error;
    text-style: bold;
}

.ast-aviso {
    color: $ast-aviso;
    text-style: bold;
}

.ast-tenue {
    color: $ast-texto-tenue;
}

.ast-acento {
    color: $ast-acento;
    text-style: bold;
}

#barra-estado {
    height: 2;
    background: $ast-superficie;
    color: $ast-texto-tenue;
    border-top: solid $ast-linea;
    padding: 0 1;
}

PanelTerminalAST {
    height: 1fr;
}

#historial-terminal {
    height: 1fr;
    background: $ast-fondo;
    border: round $ast-linea;
    padding: 0 1;
}

#entrada-terminal {
    dock: bottom;
    border: round $ast-acento;
    background: $ast-panel;
}

DataTable {
    background: $ast-panel;
}

DataTable > .datatable--header {
    background: $ast-panel;
    color: $ast-borde;
    text-style: bold;
}

Button {
    background: $ast-panel;
    border: round $ast-linea;
    color: $ast-texto;
}

Button:hover {
    background: $ast-seleccion;
}

Button.-primary {
    background: $ast-seleccion;
    border: round $ast-borde 45%;
    color: $ast-borde;
}

Button:focus,
Input:focus {
    border: round $ast-borde;
}

Input {
    background: $ast-panel;
    border: round $ast-linea;
    color: $ast-texto;
}

/* Dentro de una fila horizontal, un Input debe ceder espacio a sus hermanos
   (p. ej. un Button) en lugar de ocupar el 100% del ancho por defecto. */
Horizontal > Input {
    width: 1fr;
}

TabbedContent Tab {
    color: $ast-texto-tenue;
}

TabbedContent Tab.-active {
    color: $ast-borde;
    text-style: bold;
}

/* ---- Panel OSINT: encabezado compacto + formulario fijo + resultados con scroll ----
   PanelOSINT ya no es el contenedor que se desplaza (a diferencia de los demas
   paneles con formulario): solo #osint-resultados tiene scroll propio, para que
   "Investigar"/"Cancelar" nunca queden fuera de pantalla al revisar hallazgos
   extensos (ver docs/INTERFAZ.md y la seccion 2 de la especificacion del rediseno). */
PanelOSINT {
    height: 1fr;
}

#osint-encabezado {
    height: auto;
}

#osint-encabezado > * {
    width: auto;
    margin-right: 2;
}

/* Limite defensivo: si el nombre del proyecto fuera inusualmente largo, se recorta
   aqui en vez de seguir creciendo y empujar '#osint-estado' fuera de la pantalla. */
#osint-proyecto {
    max-width: 28;
}

/* En paneles angostos (ver ANCHO_COMPACTO_OSINT), titulo+proyecto+estado ya no caben
   en una sola fila y el estado (el dato mas importante para saber que esta pasando)
   quedaba empujado fuera del panel sin que nada avisara del recorte. Se oculta el
   nombre del proyecto -- visible en la barra lateral -- para que el estado siempre
   quede dentro del area visible, igual que '#encabezado.compacto' oculta version/so. */
#osint-encabezado.compacto #osint-proyecto {
    display: none;
}

.osint-titulo {
    text-style: bold;
    color: $ast-borde;
}

/* Sin padding-bottom/margin-bottom (solo el borde como separador): en terminales
   bajos (80x24, 100x30) cada fila que se le agrega a este formulario fijo le resta
   altura a #osint-resultados, que ya recorta su propio contenido con scroll propio. */
#osint-formulario {
    height: auto;
    border-bottom: solid $ast-borde;
}

/* Los Collapsible de Ayuda y de Fuentes viven dentro del formulario fijo: su borde
   superior y su padding inferior (del DEFAULT_CSS de Textual) suman 2 filas extra
   por cada uno aunque esten colapsados, lo que en 80x24/100x30 era la diferencia
   entre que #osint-resultados tuviera una altura usable o quedara en 1 fila. */
#osint-ayuda,
#osint-fuentes-colapsable {
    border-top: none;
    padding-bottom: 0;
}

/* El 'Contents' interno de un Collapsible expandido suma 1 fila de padding superior
   por defecto (ver DEFAULT_CSS de Textual): otra fila que, sumada al resto, le
   faltaba a #osint-resultados cuando el usuario expandia "Fuentes a consultar". */
#osint-ayuda > Contents,
#osint-fuentes-colapsable > Contents {
    padding: 0 0 0 1;
}

#osint-resultados {
    height: 1fr;
}

/* Sin esto, TabbedContent/TabPane se quedan en su altura 'auto' (la minima para su
   contenido) y dejan un hueco vacio hasta el borde de #osint-resultados en vez de
   ocupar el espacio restante: cada tabla de hallazgos debe aprovechar toda la zona de
   resultados, con su propio scroll interno si el contenido es mas largo. */
#osint-tabs,
#osint-tabs TabPane {
    height: 1fr;
}

/* Cada pestana necesita su propio scroll independiente: en terminales bajos (o en
   modo compacto, donde "Fuentes a consultar" o la fila de Informe se apilan en
   vertical) su contenido puede superar la altura fija de 1fr sin que el scroll de
   #osint-resultados (que envuelve a todo #osint-tabs) lo revele, dejando el boton
   "Generar informe" o filas finales de una tabla inaccesibles ni por scroll ni por
   teclado. */
#osint-tabs TabPane {
    overflow-y: auto;
}

#osint-tabs DataTable {
    height: 1fr;
    min-height: 5;
}

/* Una fila de controles (tipo+objetivo, botones, historial, informe): horizontal por
   defecto; '.compacta' la apila verticalmente en terminales angostas
   (PanelOSINT._ajustar_responsivo) para que ningun campo quede recortado. */
.osint-fila {
    height: auto;
}

.osint-fila.compacta {
    layout: vertical;
    height: auto;
}

.osint-fila.compacta > * {
    width: 1fr;
    margin-bottom: 0;
}

#osint-region,
#osint-autorizo {
    margin-top: 1;
}

/* Mismo bug que #encabezado > * (ver comentario arriba): sin 'width: auto' explicito,
   el Static de la etiqueta "Investigacion guardada:" reclama casi todo el ancho de su
   fila horizontal y deja el Select de historial reducido a 1 columna (inutilizable). */
#osint-fila-historial > Static {
    width: auto;
    margin-right: 1;
}

#osint-cargando {
    width: 5;
    height: 1;
}

/* Un objetivo puede tener bastantes fuentes aplicables (hasta 6-8): sin un tope bajo,
   expandir "Fuentes a consultar" en una terminal de 24-30 filas por si solo llegaba a
   consumir toda la altura del formulario y dejaba #osint-resultados en 1 fila (igual
   que el bug original, pero disparado por esta interaccion normal del usuario en vez
   de por el formulario en reposo). La lista sigue siendo scrollable por su cuenta. */
#osint-fuentes {
    height: auto;
    max-height: 4;
}

/* Operaciones mantiene el caso y el último estado visibles al cambiar de pestaña. */
PanelOperaciones,
#ops-pestanas,
#ops-pestanas TabPane {
    height: 1fr;
}

.ops-contenido {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#ops-contexto,
.ops-botones {
    height: auto;
}

#ops-contexto > Static {
    width: 1fr;
    height: 1;
    margin-right: 1;
}

#ops-caso {
    max-width: 23;
}

#ops-contexto {
    align-vertical: middle;
}

.ops-botones > Button {
    min-width: 0;
    width: 1fr;
}

PanelOperaciones.compacto .ops-botones {
    layout: vertical;
}

#ops-mensaje {
    height: auto;
    max-height: 3;
    overflow-y: auto;
    color: $ast-texto-tenue;
    border-top: solid $ast-linea;
}

.trafico-etiqueta {
    color: $ast-texto-tenue;
}
