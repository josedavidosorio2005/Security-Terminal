/* Paleta AURABYTE Security Terminal (AST) */
$ast-fondo: #060B18;
$ast-panel: #0D172B;
$ast-borde: #00D9F5;
$ast-acento: #A855F7;
$ast-exito: #22C55E;
$ast-error: #EF4444;
$ast-aviso: #FACC15;
$ast-texto: #E5E7EB;
$ast-texto-tenue: #8B98B4;

Screen {
    background: $ast-fondo;
    color: $ast-texto;
}

#encabezado {
    height: 3;
    background: $ast-panel;
    border-bottom: solid $ast-borde;
    color: $ast-texto;
    padding: 0 1;
}

/* Sin 'width: auto' explicito, un Static hijo de un Horizontal reclama TODO el
   ancho restante del contenedor en vez de su ancho de contenido: con cinco
   Static en #encabezado (logo, nombre, version, proyecto, so) eso empuja cada
   uno tras el primero fuera de la pantalla visible (bug real, no solo
   cosmetico: el nombre AURABYTE quedaba oculto). Cada hijo del encabezado
   fija su propio ancho de contenido explicitamente para evitarlo. */
#encabezado > * {
    width: auto;
}

/* Escudo de marca (azul/cian): usado en la barra superior y en el panel
   de inicio (ver eurabyte_security/marca.py: ESCUDO_COMPACTO/ESCUDO_ASCII). */
.logo {
    color: $ast-borde;
    text-style: bold;
}

#encabezado .nombre {
    color: $ast-texto;
    text-style: bold;
}

#encabezado .dato {
    color: $ast-texto-tenue;
}

/* En terminales angostas, 'version' y 'so' se ocultan primero (ver
   AuraByteApp._ajustar_responsivo): el nombre y el proyecto activo son la
   informacion que de verdad importa para saber donde esta el usuario. */
#encabezado.compacto #encabezado-version,
#encabezado.compacto #encabezado-so {
    display: none;
}

/* Boton para plegar/desplegar el panel contextual derecho a demanda (no solo
   automaticamente por ancho): ver AuraByteApp.action_alternar_info. */
.boton-info {
    dock: right;
    height: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: $ast-texto-tenue;
    padding: 0 1;
}

.boton-info:hover {
    color: $ast-borde;
    background: transparent;
}

#cuerpo {
    height: 1fr;
}

#barra-lateral {
    width: 22;
    background: $ast-panel;
    border-right: solid $ast-borde;
}

#barra-lateral.compacta {
    width: 16;
}

#barra-lateral OptionList {
    background: $ast-panel;
    color: $ast-texto;
}

#barra-lateral OptionList > .option-list--option-highlighted {
    background: $ast-acento 40%;
    color: $ast-texto;
}

#switcher-central {
    width: 1fr;
    background: $ast-fondo;
    padding: 1 2;
}

#panel-info {
    width: 34;
    background: $ast-panel;
    border-left: solid $ast-borde;
    padding: 1 2;
}

#panel-info.oculto {
    display: none;
}

.titulo-panel {
    text-style: bold;
    color: $ast-borde;
    margin-bottom: 1;
}

/* Subtitulo de una seccion dentro de un panel (p. ej. "1. Elige las plantillas",
   "2. Confirma el objetivo"): agrupa controles relacionados en pasos faciles de
   seguir sin necesitar un titulo tan prominente como .titulo-panel. */
.ast-subtitulo {
    text-style: bold;
    color: $ast-acento;
    margin-top: 1;
}

#inicio-marca {
    height: auto;
    margin-bottom: 1;
}

#inicio-escudo {
    width: auto;
    margin-right: 2;
}

.ast-panel {
    background: $ast-panel;
    border: solid $ast-borde;
    padding: 1 2;
}

.ast-caja {
    background: $ast-panel;
    border: round $ast-borde;
    padding: 1 2;
    margin-bottom: 1;
}

.ast-exito {
    color: $ast-exito;
    text-style: bold;
}

.ast-error {
    color: $ast-error;
    text-style: bold;
}

.ast-aviso {
    color: $ast-aviso;
    text-style: bold;
}

.ast-tenue {
    color: $ast-texto-tenue;
}

.ast-acento {
    color: $ast-acento;
    text-style: bold;
}

#barra-estado {
    height: 1;
    background: $ast-panel;
    color: $ast-texto-tenue;
    border-top: solid $ast-borde;
    padding: 0 1;
}

#barra-estado .ok {
    color: $ast-exito;
}

#barra-estado .error {
    color: $ast-error;
}

PanelTerminalAST {
    height: 1fr;
}

#historial-terminal {
    height: 1fr;
    background: $ast-fondo;
    border: round $ast-borde;
    padding: 0 1;
}

#entrada-terminal {
    dock: bottom;
    border: round $ast-acento;
    background: $ast-panel;
}

#banner-ast {
    color: $ast-borde;
    text-style: bold;
    margin-bottom: 1;
}

DataTable {
    background: $ast-panel;
}

DataTable > .datatable--header {
    background: $ast-panel;
    color: $ast-borde;
    text-style: bold;
}

Button {
    background: $ast-panel;
    border: round $ast-borde;
    color: $ast-texto;
}

Button:hover {
    background: $ast-acento 30%;
}

Button.-primary {
    border: round $ast-acento;
    color: $ast-acento;
}

Input {
    background: $ast-panel;
    border: round $ast-borde;
    color: $ast-texto;
}

/* Dentro de una fila horizontal, un Input debe ceder espacio a sus hermanos
   (p. ej. un Button) en lugar de ocupar el 100% del ancho por defecto. */
Horizontal > Input {
    width: 1fr;
}

TabbedContent Tab {
    color: $ast-texto-tenue;
}

TabbedContent Tab.-active {
    color: $ast-borde;
    text-style: bold;
}

/* ---- Panel OSINT: encabezado compacto + formulario fijo + resultados con scroll ----
   PanelOSINT ya no es el contenedor que se desplaza (a diferencia de los demas
   paneles con formulario): solo #osint-resultados tiene scroll propio, para que
   "Investigar"/"Cancelar" nunca queden fuera de pantalla al revisar hallazgos
   extensos (ver docs/INTERFAZ.md y la seccion 2 de la especificacion del rediseno). */
PanelOSINT {
    height: 1fr;
}

#osint-encabezado {
    height: auto;
}

#osint-encabezado > * {
    width: auto;
    margin-right: 2;
}

/* Limite defensivo: si el nombre del proyecto fuera inusualmente largo, se recorta
   aqui en vez de seguir creciendo y empujar '#osint-estado' fuera de la pantalla. */
#osint-proyecto {
    max-width: 28;
}

/* En paneles angostos (ver ANCHO_COMPACTO_OSINT), titulo+proyecto+estado ya no caben
   en una sola fila y el estado (el dato mas importante para saber que esta pasando)
   quedaba empujado fuera del panel sin que nada avisara del recorte. Se oculta el
   nombre del proyecto -- visible en la barra lateral -- para que el estado siempre
   quede dentro del area visible, igual que '#encabezado.compacto' oculta version/so. */
#osint-encabezado.compacto #osint-proyecto {
    display: none;
}

.osint-titulo {
    text-style: bold;
    color: $ast-borde;
}

/* Sin padding-bottom/margin-bottom (solo el borde como separador): en terminales
   bajos (80x24, 100x30) cada fila que se le agrega a este formulario fijo le resta
   altura a #osint-resultados, que ya recorta su propio contenido con scroll propio. */
#osint-formulario {
    height: auto;
    border-bottom: solid $ast-borde;
}

/* Los Collapsible de Ayuda y de Fuentes viven dentro del formulario fijo: su borde
   superior y su padding inferior (del DEFAULT_CSS de Textual) suman 2 filas extra
   por cada uno aunque esten colapsados, lo que en 80x24/100x30 era la diferencia
   entre que #osint-resultados tuviera una altura usable o quedara en 1 fila. */
#osint-ayuda,
#osint-fuentes-colapsable {
    border-top: none;
    padding-bottom: 0;
}

/* El 'Contents' interno de un Collapsible expandido suma 1 fila de padding superior
   por defecto (ver DEFAULT_CSS de Textual): otra fila que, sumada al resto, le
   faltaba a #osint-resultados cuando el usuario expandia "Fuentes a consultar". */
#osint-ayuda > Contents,
#osint-fuentes-colapsable > Contents {
    padding: 0 0 0 1;
}

#osint-resultados {
    height: 1fr;
}

/* Sin esto, TabbedContent/TabPane se quedan en su altura 'auto' (la minima para su
   contenido) y dejan un hueco vacio hasta el borde de #osint-resultados en vez de
   ocupar el espacio restante: cada tabla de hallazgos debe aprovechar toda la zona de
   resultados, con su propio scroll interno si el contenido es mas largo. */
#osint-tabs,
#osint-tabs TabPane {
    height: 1fr;
}

/* Cada pestana necesita su propio scroll independiente: en terminales bajos (o en
   modo compacto, donde "Fuentes a consultar" o la fila de Informe se apilan en
   vertical) su contenido puede superar la altura fija de 1fr sin que el scroll de
   #osint-resultados (que envuelve a todo #osint-tabs) lo revele, dejando el boton
   "Generar informe" o filas finales de una tabla inaccesibles ni por scroll ni por
   teclado. */
#osint-tabs TabPane {
    overflow-y: auto;
}

#osint-tabs DataTable {
    height: 1fr;
    min-height: 5;
}

/* Una fila de controles (tipo+objetivo, botones, historial, informe): horizontal por
   defecto; '.compacta' la apila verticalmente en terminales angostas
   (PanelOSINT._ajustar_responsivo) para que ningun campo quede recortado. */
.osint-fila {
    height: auto;
}

.osint-fila.compacta {
    layout: vertical;
    height: auto;
}

.osint-fila.compacta > * {
    width: 1fr;
    margin-bottom: 0;
}

#osint-region,
#osint-autorizo {
    margin-top: 1;
}

/* Mismo bug que #encabezado > * (ver comentario arriba): sin 'width: auto' explicito,
   el Static de la etiqueta "Investigacion guardada:" reclama casi todo el ancho de su
   fila horizontal y deja el Select de historial reducido a 1 columna (inutilizable). */
#osint-fila-historial > Static {
    width: auto;
    margin-right: 1;
}

#osint-cargando {
    width: 5;
    height: 1;
}

/* Un objetivo puede tener bastantes fuentes aplicables (hasta 6-8): sin un tope bajo,
   expandir "Fuentes a consultar" en una terminal de 24-30 filas por si solo llegaba a
   consumir toda la altura del formulario y dejaba #osint-resultados en 1 fila (igual
   que el bug original, pero disparado por esta interaccion normal del usuario en vez
   de por el formulario en reposo). La lista sigue siendo scrollable por su cuenta. */
#osint-fuentes {
    height: auto;
    max-height: 4;
}
