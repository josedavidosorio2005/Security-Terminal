/* Paleta AURABYTE Security Terminal (AST) */
$ast-fondo: #060B18;
$ast-panel: #0D172B;
$ast-borde: #00D9F5;
$ast-acento: #A855F7;
$ast-exito: #22C55E;
$ast-error: #EF4444;
$ast-aviso: #FACC15;
$ast-texto: #E5E7EB;
$ast-texto-tenue: #8B98B4;

Screen {
    background: $ast-fondo;
    color: $ast-texto;
}

#encabezado {
    height: 3;
    background: $ast-panel;
    border-bottom: solid $ast-borde;
    color: $ast-texto;
    padding: 0 1;
}

/* Sin 'width: auto' explicito, un Static hijo de un Horizontal reclama TODO el
   ancho restante del contenedor en vez de su ancho de contenido: con cinco
   Static en #encabezado (logo, nombre, version, proyecto, so) eso empuja cada
   uno tras el primero fuera de la pantalla visible (bug real, no solo
   cosmetico: el nombre AURABYTE quedaba oculto). Cada hijo del encabezado
   fija su propio ancho de contenido explicitamente para evitarlo. */
#encabezado > * {
    width: auto;
}

/* Escudo de marca (azul/cian): usado en la barra superior y en el panel
   de inicio (ver eurabyte_security/marca.py: ESCUDO_COMPACTO/ESCUDO_ASCII). */
.logo {
    color: $ast-borde;
    text-style: bold;
}

#encabezado .nombre {
    color: $ast-texto;
    text-style: bold;
}

#encabezado .dato {
    color: $ast-texto-tenue;
}

/* En terminales angostas, 'version' y 'so' se ocultan primero (ver
   AuraByteApp._ajustar_responsivo): el nombre y el proyecto activo son la
   informacion que de verdad importa para saber donde esta el usuario. */
#encabezado.compacto #encabezado-version,
#encabezado.compacto #encabezado-so {
    display: none;
}

/* Boton para plegar/desplegar el panel contextual derecho a demanda (no solo
   automaticamente por ancho): ver AuraByteApp.action_alternar_info. */
.boton-info {
    dock: right;
    height: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: $ast-texto-tenue;
    padding: 0 1;
}

.boton-info:hover {
    color: $ast-borde;
    background: transparent;
}

#cuerpo {
    height: 1fr;
}

#barra-lateral {
    width: 22;
    background: $ast-panel;
    border-right: solid $ast-borde;
}

#barra-lateral.compacta {
    width: 16;
}

#barra-lateral OptionList {
    background: $ast-panel;
    color: $ast-texto;
}

#barra-lateral OptionList > .option-list--option-highlighted {
    background: $ast-acento 40%;
    color: $ast-texto;
}

#switcher-central {
    width: 1fr;
    background: $ast-fondo;
    padding: 1 2;
}

#panel-info {
    width: 34;
    background: $ast-panel;
    border-left: solid $ast-borde;
    padding: 1 2;
}

#panel-info.oculto {
    display: none;
}

.titulo-panel {
    text-style: bold;
    color: $ast-borde;
    margin-bottom: 1;
}

/* Subtitulo de una seccion dentro de un panel (p. ej. "1. Elige las plantillas",
   "2. Confirma el objetivo"): agrupa controles relacionados en pasos faciles de
   seguir sin necesitar un titulo tan prominente como .titulo-panel. */
.ast-subtitulo {
    text-style: bold;
    color: $ast-acento;
    margin-top: 1;
}

#inicio-marca {
    height: auto;
    margin-bottom: 1;
}

#inicio-escudo {
    width: auto;
    margin-right: 2;
}

.ast-panel {
    background: $ast-panel;
    border: solid $ast-borde;
    padding: 1 2;
}

.ast-caja {
    background: $ast-panel;
    border: round $ast-borde;
    padding: 1 2;
    margin-bottom: 1;
}

.ast-exito {
    color: $ast-exito;
    text-style: bold;
}

.ast-error {
    color: $ast-error;
    text-style: bold;
}

.ast-aviso {
    color: $ast-aviso;
    text-style: bold;
}

.ast-tenue {
    color: $ast-texto-tenue;
}

.ast-acento {
    color: $ast-acento;
    text-style: bold;
}

#barra-estado {
    height: 1;
    background: $ast-panel;
    color: $ast-texto-tenue;
    border-top: solid $ast-borde;
    padding: 0 1;
}

#barra-estado .ok {
    color: $ast-exito;
}

#barra-estado .error {
    color: $ast-error;
}

PanelTerminalAST {
    height: 1fr;
}

#historial-terminal {
    height: 1fr;
    background: $ast-fondo;
    border: round $ast-borde;
    padding: 0 1;
}

#entrada-terminal {
    dock: bottom;
    border: round $ast-acento;
    background: $ast-panel;
}

#banner-ast {
    color: $ast-borde;
    text-style: bold;
    margin-bottom: 1;
}

DataTable {
    background: $ast-panel;
}

DataTable > .datatable--header {
    background: $ast-panel;
    color: $ast-borde;
    text-style: bold;
}

Button {
    background: $ast-panel;
    border: round $ast-borde;
    color: $ast-texto;
}

Button:hover {
    background: $ast-acento 30%;
}

Button.-primary {
    border: round $ast-acento;
    color: $ast-acento;
}

Input {
    background: $ast-panel;
    border: round $ast-borde;
    color: $ast-texto;
}

/* Dentro de una fila horizontal, un Input debe ceder espacio a sus hermanos
   (p. ej. un Button) en lugar de ocupar el 100% del ancho por defecto. */
Horizontal > Input {
    width: 1fr;
}

TabbedContent Tab {
    color: $ast-texto-tenue;
}

TabbedContent Tab.-active {
    color: $ast-borde;
    text-style: bold;
}
